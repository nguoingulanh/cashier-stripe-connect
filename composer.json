{
    "name": "nguoingulanh/cashier-connect",
    "description": "Stripe Connect (onboarding, payouts, transfers, webhooks) for Laravel Cashier.",
    "keywords": ["laravel", "cashier", "stripe", "stripe-connect", "marketplace", "payouts", "billing"],
    "homepage": "https://github.com/nguoingulanh/cashier-stripe-connect",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "nguoingulanh",
            "homepage": "https://github.com/nguoingulanh",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/nguoingulanh/cashier-stripe-connect/issues",
        "source": "https://github.com/nguoingulanh/cashier-stripe-connect",
        "security": "https://github.com/nguoingulanh/cashier-stripe-connect/security/policy"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "laravel/cashier": "^15.0|^16.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Nguoingulanh\\CashierConnect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nguoingulanh\\CashierConnect\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Nguoingulanh\\CashierConnect\\CashierConnectServiceProvider"
            ],
            "aliases": {
                "CashierConnect": "Nguoingulanh\\CashierConnect\\Facades\\CashierConnect"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
